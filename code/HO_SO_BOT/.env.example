# Thông tin bắt buộc cho bot Telegram
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=123456:ABC-YourBotToken

# Tên file session cho tài khoản người dùng (Telethon sẽ tạo file .session trong thư mục runtime)
TELETHON_SESSION=sniper_session

# Danh sách channel/group cần theo dõi, cách nhau bằng dấu phẩy
TELEGRAM_WATCH_CHANNELS=khuyenmai_game_channel,ma_freefire,https://t.me/example_group

# Tuỳ chọn: tuỳ biến regex tìm mã (mặc định đã bao gồm 2 pattern cơ bản)
#SNIPER_RULES=\b[A-Z0-9]{12}\b,\b[0-9]{14}\b

# Tuỳ chọn: số lượng bản ghi lịch sử lưu và thư mục dữ liệu
#SNIPER_HISTORY_SIZE=50
#SNIPER_DATA_DIR=runtime
